@using MudBlazor;
@inherits LayoutComponentBase

<MudThemeProvider Theme="Theme"/>
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="2" Color="Color.Primary" Dense="false">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h6" Class="ml-2" Style="font-family:'Playfair Display',serif;">
            💅 Nail Salon
        </MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.CalendarMonth"
                       Color="Color.Inherit"
                       Href="/booking" />
        <MudIconButton Icon="@Icons.Material.Filled.Dashboard"
                       Color="Color.Inherit"
                       Href="/admin" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="pa-6">
        <MudContainer MaxWidth="MaxWidth.Large">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = false;
    private void DrawerToggle() => _drawerOpen = !_drawerOpen;

    public static MudTheme Theme => new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#6A1B9A", // deep plum
            Secondary = "#C2185B", // rose
            Tertiary = "#B08D57", // rose gold
            Background = "#FDF7FA", // blush white
            Surface = "#FFFFFF",
            AppbarBackground = "#6A1B9A",
            AppbarText = "#FFFFFF",
            DrawerBackground = "#F5E9F2",
            DrawerText = "#4A148C",
            TextPrimary = "#2D1B36",
            TextSecondary = "#6E5A78",
            ActionDefault = "#6A1B9A",
            Success = "#2E7D32",
            Warning = "#EF6C00",
            Error = "#C62828",
            Info = "#0277BD",
            LinesDefault = "#EBD9E4",
            TableLines = "#F0E4EC"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#CE93D8",
            Secondary = "#F48FB1",
            Tertiary = "#D4B483",
            Background = "#1A1020",
            Surface = "#241530",
            AppbarBackground = "#2A1338",
            AppbarText = "#F3E5F5",
            DrawerBackground = "#1F1229",
            DrawerText = "#E1BEE7",
            TextPrimary = "#F3E5F5",
            TextSecondary = "#B39DBC"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = new[] { "Roboto", "Helvetica", "Arial", "sans-serif" }
            },
            H1 = new H1Typography
            {
                FontFamily = new[] { "'Playfair Display'", "Georgia", "serif" },
                FontWeight = "700"
            },
            H2 = new H2Typography
            {
                FontFamily = new[] { "'Playfair Display'", "Georgia", "serif" },
                FontWeight = "700"
            },
            H3 = new H3Typography
            {
                FontFamily = new[] { "'Playfair Display'", "Georgia", "serif" },
                FontWeight = "600"
            },
            H4 = new H4Typography
            {
                FontFamily = new[] { "'Playfair Display'", "Georgia", "serif" },
                FontWeight = "600"
            },
            H5 = new H5Typography
            {
                FontFamily = new[] { "'Playfair Display'", "Georgia", "serif" },
                FontWeight = "600"
            },
            Button = new ButtonTypography
            {
                FontWeight = "600",
                TextTransform = "none",
                LetterSpacing = "0.4px"
            }
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "12px",
            AppbarHeight = "64px"
        },
        Shadows = new Shadow(),
        ZIndex = new ZIndex()
    };

}
